<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="NetworkSwitcher.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <appSettings>
    <!-- Путь к папке с zapret (батники, winws.exe). Подставляется автоматически при первом запуске. -->
    <add key="ZapretFolderPath" value="C:\zapret" />
    <!-- Разрешить пользовательские названия слотов и батников -->
    <add key="UseCustomNames" value="false" />
    <add key="Slot1Name" value="Стратегия 9 (ALT9)" />
    <add key="Slot1Bat" value="general (ALT9).bat" />
    <add key="Slot2Name" value="Стратегия 11 (ALT11)" />
    <add key="Slot2Bat" value="general (ALT11).bat" />
    <!-- Путь к warp-cli.exe из установки Cloudflare WARP -->
    <add key="WarpCliPath" value="C:\Program Files\Cloudflare\Cloudflare WARP\warp-cli.exe" />
    <!-- Путь к amneziawg.exe и .conf файлу туннеля AmneziaWG -->
    <add key="AmneziaExePath" value="C:\Program Files\AmneziaWG\amneziawg.exe" />
    <add key="AmneziaConfPath" value="C:\Program Files\AmneziaWG\WARP.conf" />
    <!-- Имя туннеля AmneziaWG (БЕЗ расширения .conf) -->
    <add key="AmneziaTunnelName" value="WARP" />
    <!-- Запускать приложение вместе с Windows (через Планировщик заданий) -->
    <add key="AutoStartWithWindows" value="false" />
    <!-- Текущая тема интерфейса: true — тёмная, false — светлая -->
    <add key="DarkTheme" value="false" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <userSettings>
    <NetworkSwitcher.Properties.Settings>
      <setting name="Slot1Active" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="Slot2Active" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="WarpActive" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="AmneziaActive" serializeAs="String">
        <value>False</value>
      </setting>
    </NetworkSwitcher.Properties.Settings>
  </userSettings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>
